{
    "name": "anginger/ai-api",
    "description": "Anginger AI - ChatGPT-style chat app on Yii 2, proxying the OpenAI API.",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.2",
        "yiisoft/yii2": "~2.0.0",
        "ramsey/uuid": "^4.10"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://asset-packagist.org"
        }
    ],
    "autoload": {
        "psr-4": {
            "anginger\\": ""
        }
    },
    "config": {
        "allow-plugins": {
            "yiisoft/yii2-composer": true
        },
        "process-timeout": 600
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    }
}
